# BehavioralOS – Variables de entorno de desarrollo local
# Copiar a .env y reemplazar los valores de ejemplo antes de levantar los servicios.
# Aligned to Supabase official snapshot commit e2e2fac40ba532142bbb31c04313e25394408ca0

############
# Secrets
# YOU MUST CHANGE THESE BEFORE GOING INTO PRODUCTION
############
POSTGRES_PASSWORD=your-super-secret-and-long-postgres-password
JWT_SECRET=your-super-secret-jwt-token-with-at-least-32-characters-long
ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyAgCiAgICAicm9sZSI6ICJhbm9uIiwKICAgICJpc3MiOiAic3VwYWJhc2UtZGVtbyIsCiAgICAiaWF0IjogMTY0MTc2OTIwMCwKICAgICJleHAiOiAxNzk5NTM1NjAwCn0.dc_X5iR_VP_qT0zsiyj_I_OZ2T9FtRU2BBNWN8Bu4GE
SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyAgCiAgICAicm9sZSI6ICJzZXJ2aWNlX3JvbGUiLAogICAgImlzcyI6ICJzdXBhYmFzZS1kZW1vIiwKICAgICJpYXQiOiAxNjQxNzY5MjAwLAogICAgImV4cCI6IDE3OTk1MzU2MDAKfQ.DaYlNEoUrrEn2Ig7tqibS-PHK5vgusbcbo7X36XVt4Q
DASHBOARD_USERNAME=supabase
DASHBOARD_PASSWORD=this_password_is_insecure_and_should_be_updated

############
# Database - You can change these to any PostgreSQL database that has logical replication enabled.
############
POSTGRES_HOST=db
POSTGRES_DB=postgres
POSTGRES_PORT=5432
# default user is postgres

############
# API Proxy - Configuration for the Kong Reverse proxy.
############
KONG_HTTP_PORT=8000
KONG_HTTPS_PORT=8443

############
# API - Configuration for PostgREST.
############
PGRST_DB_SCHEMAS=public,storage

############
# Auth - Configuration for the GoTrue authentication server.
############

## General
SITE_URL=http://localhost:3000
ADDITIONAL_REDIRECT_URLS=http://localhost:3000
JWT_EXPIRY=3600
DISABLE_SIGNUP=false
API_EXTERNAL_URL=http://localhost:8000

## Mailer Config
MAILER_URLPATHS_CONFIRMATION=/auth/v1/verify
MAILER_URLPATHS_INVITE=/auth/v1/verify
MAILER_URLPATHS_RECOVERY=/auth/v1/verify
MAILER_URLPATHS_EMAIL_CHANGE=/auth/v1/verify

## Email auth
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=false
SMTP_ADMIN_EMAIL=admin@example.com
SMTP_HOST=supabase-mail
SMTP_PORT=2500
SMTP_USER=fake_mail_user
SMTP_PASS=fake_mail_password
SMTP_SENDER_NAME=fake_sender
ENABLE_ANONYMOUS_USERS=false

## Phone auth
ENABLE_PHONE_SIGNUP=true
ENABLE_PHONE_AUTOCONFIRM=true

############
# Studio - Configuration for the Dashboard
############
STUDIO_DEFAULT_ORGANIZATION=Default Organization
STUDIO_DEFAULT_PROJECT=Default Project
STUDIO_PORT=3000
# replace if you intend to use Studio outside of localhost
SUPABASE_PUBLIC_URL=http://localhost:8000

############
# Storage / imgproxy
############
FILE_SIZE_LIMIT=52428800
STORAGE_BACKEND=file
ENABLE_IMAGE_TRANSFORMATION=true
IMGPROXY_ENABLE_WEBP_DETECTION=true

############
# Backend (FastAPI)
############
APP_ENV=development
APP_NAME=BehavioralOS
APP_VERSION=0.2.0
APP_HOST=0.0.0.0
APP_PORT=8001
APP_DEBUG=true
SECRET_KEY=change-this-secret-in-production
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000

# Base de datos (usa el contenedor local de Postgres)
SUPABASE_URL=http://localhost:8000
SUPABASE_ANON_KEY=${ANON_KEY}
SUPABASE_SERVICE_ROLE_KEY=${SERVICE_ROLE_KEY}
SUPABASE_JWT_SECRET=${JWT_SECRET}
BACKEND_DB_USER=backend_app
# Required distinct secret; never reuse POSTGRES_PASSWORD.
# After setting this value, run scripts/provision-backend-role.sh once on the
# initialized database to create (or update) the backend_app PostgreSQL role.
BACKEND_DB_PASSWORD=
# Async SQLAlchemy URL for the dedicated application role.
DATABASE_URL=postgresql+asyncpg://${BACKEND_DB_USER}:${BACKEND_DB_PASSWORD}@db:${POSTGRES_PORT}/${POSTGRES_DB}
# Administrative migration URL; never use it for application queries.
MIGRATION_DATABASE_URL=postgresql+asyncpg://postgres:${POSTGRES_PASSWORD}@db:${POSTGRES_PORT}/${POSTGRES_DB}
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Autenticación y seguridad
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
JWT_ALGORITHM=HS256
SUPABASE_JWT_AUDIENCE=authenticated
ENCRYPTION_KEY=change-this-encryption-key-in-production
PASSWORD_HASH_ALGORITHM=bcrypt
PASSWORD_SALT_ROUNDS=12
TWO_FACTOR_AUTH_REQUIRED=false

############
# IA y modelos (preparado para futuros niveles)
############
GEMMA_MODEL_PATH=/models/gemma-2b-q4.gguf
GEMMA_CONTEXT_SIZE=4096
GEMMA_TEMPERATURE=0.7
GEMMA_TOP_K=40
GEMMA_TOP_P=0.9
GEMMA_MAX_TOKENS=512
WHISPER_MODEL_PATH=/models/whisper-tiny.onnx
WHISPER_LANGUAGE=es
MEDIAPIPE_FACE_MESH_ENABLED=false
EMBEDDING_MODEL_PATH=/models/multilingual-e5-small.onnx

############
# Integraciones de pago (placeholder; se activan en Nivel 4.2)
############
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_CURRENCY=mxn

MERCADO_PAGO_ACCESS_TOKEN=APP_USR-...
MERCADO_PAGO_PUBLIC_KEY=APP_USR-...
MERCADO_PAGO_WEBHOOK_SECRET=...

FACTURAPI_API_KEY=...
FACTURAPI_TAX_SYSTEM=612
FACTURAPI_USE_CFDI=G03

############
# Comunicación (placeholder)
############
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=no-reply@behavioralos.local
SMTP_PASSWORD=...
SMTP_FROM_EMAIL=no-reply@behavioralos.local
SMTP_FROM_NAME=BehavioralOS

SENDGRID_API_KEY=SG.xxx
RESEND_API_KEY=re_xxx

TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE_NUMBER=+1234567890

WHATSAPP_API_KEY=...
WHATSAPP_PHONE_NUMBER_ID=1234567890

############
# Calendario (placeholder)
############
GOOGLE_OAUTH_CLIENT_ID=...apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=...
GOOGLE_CALENDAR_ID=primary

MICROSOFT_OAUTH_CLIENT_ID=...
MICROSOFT_OAUTH_CLIENT_SECRET=...

############
# Frontend (React)
############
REACT_APP_API_URL=http://localhost:8001/api/v1
REACT_APP_WS_URL=ws://localhost:8001/ws
REACT_APP_SUPABASE_URL=http://localhost:8000
REACT_APP_SUPABASE_ANON_KEY=${ANON_KEY}
REACT_APP_STRIPE_PUBLISHABLE_KEY=${STRIPE_PUBLISHABLE_KEY}
REACT_APP_MERCADO_PAGO_PUBLIC_KEY=${MERCADO_PAGO_PUBLIC_KEY}
REACT_APP_GOOGLE_OAUTH_CLIENT_ID=${GOOGLE_OAUTH_CLIENT_ID}
REACT_APP_ENVIRONMENT=development

############
# DevOps / observabilidad
############
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=
REDIS_SSL=false

SENTRY_DSN=https://...@sentry.io/...
PROMETHEUS_ENABLED=false
JAEGER_ENABLED=false
JAEGER_AGENT_HOST=localhost
JAEGER_AGENT_PORT=6831
LOG_LEVEL=info
